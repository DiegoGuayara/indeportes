PORT=10101
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=your_database_name

# Genera un valor secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Solo se usa para crear el primer administrador cuando todavía no hay uno activo.
ADMIN_NAME=Administradora inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password-of-at-least-12-characters

# Origen exacto del front. En Railway, usa la URL publicada de Vercel.
FRONTEND_URL=http://localhost:5173
